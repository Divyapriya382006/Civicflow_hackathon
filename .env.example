# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: groq | gemini | claude | ollama | grok
LLM_PROVIDER="groq"

GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# ─── Execution Mode ───────────────────────────────────────────────────────────
# llm       = LangGraph agentic loop (full LLM reasoning per step)
# fasttrack = Zero-LLM deterministic Playwright execution (no API cost)
EXECUTION_MODE="llm"

# ─── Browser ─────────────────────────────────────────────────────────────────
BROWSER_HEADED="true"
BROWSER_SLOW_MO="0"

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" to enable strict KMS enforcement (crashes if key is missing)
ENVIRONMENT="development"

# ─── CivicGuard KMS — HMAC-SHA256 Session Integrity Signing ─────────────────
# REQUIRED for tamper-evident audit fingerprinting on every agent session.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production, load this from your secrets manager (AWS Secrets Manager, GCP Secret Manager, etc.)
# NEVER use the default fallback ('CIVICFLOW_DEV_ONLY_KMS_KEY_NOT_FOR_PRODUCTION') in production.
CIVICFLOW_KMS_MASTER_KEY_V2="YOUR_64_HEX_CHAR_RANDOM_KEY_HERE"


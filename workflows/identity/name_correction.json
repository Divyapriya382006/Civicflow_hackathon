{
  "id": "name_correction",
  "portal_id": "identity",
  "description": "Correct a citizen name in a controlled identity portal.",
  "goal": "Update the citizen name and submit the correction for officer review.",
  "portal_path": "/identity/name-correction.html",
  "allowed_domains": ["127.0.0.1", "localhost"],
  "required_information": ["full_name"],
  "required_documents": [],
  "instructions": ["Enter the corrected name", "Review the entered name", "Submit for officer review"],
  "steps": [
    {"id": "name", "intent": "Enter the corrected citizen name", "action": "fill", "value_ref": "full_name", "risk": "LOW"},
    {"id": "review", "intent": "Review the entered name", "action": "click", "target_text": "Review", "risk": "MEDIUM"},
    {"id": "submit", "intent": "Submit the correction", "action": "click", "target_text": "Submit", "risk": "HIGH", "requires_hitl": true}
  ],
  "constraints": {"allow_mutations": true, "allowed_actions": ["fill", "click", "wait"]},
  "risk_rules": {"submit": {"requires_hitl": true}},
  "verification_rules": [{"type": "required_element"}, {"type": "page_state"}],
  "completion_conditions": [{"type": "success_message", "text": "Application received"}]
}
